# Copy to .env.local. Base URL of the FastAPI backend, as reached from the
# browser (all fetching is client-side so ingestion status can be polled).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Google sign-in (Auth.js). Leave unset to run without auth. ---
# Create an OAuth 2.0 "Web application" client at
# https://console.cloud.google.com/apis/credentials
#   Authorized JavaScript origins: http://localhost:3000
#   Authorized redirect URIs:      http://localhost:3000/api/auth/callback/google
# The backend needs the SAME client id in its own GOOGLE_CLIENT_ID.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Generate with: npx auth secret
AUTH_SECRET=
# Required in production (Vercel): the canonical site URL.
# AUTH_URL=https://your-app.vercel.app
