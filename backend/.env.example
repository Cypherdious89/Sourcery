# Copy to .env and fill in real values. NEVER commit .env — it is gitignored.
# ---------------------------------------------------------------------------

# --- App ---
APP_NAME="NotebookLM RAG Gateway"
ENVIRONMENT=development
# Comma-separated list of origins allowed to call the API (the frontend).
# In production this is your Vercel URL, e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:3000

# --- Database (Postgres + pgvector) ---
# Local dev via docker-compose (see docker-compose.yml).
# SQLAlchemy + psycopg v3 driver URL format:
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
# Production (Neon) — use the DIRECT (non-pooled) host and require SSL:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- LLM providers (routed through the gateway) ---
# Required. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional fallback provider — Groq, OpenAI-API-compatible, genuinely free
# tier (no card required, resets daily). Replaces an earlier Kimi/Moonshot AI
# attempt at this slot, which needed a paid recharge. Get a key at
# https://console.groq.com/keys. Empty => fallback is GEMINI_FALLBACK_MODEL
# (same provider, more capable model).
GROQ_API_KEY=

# Model identifiers, tried in order: GEMINI_PRIMARY_MODEL ->
# GEMINI_FALLBACK_MODEL -> GROQ_FALLBACK_MODEL -> GROQ_FALLBACK_MODEL_2 ->
# GEMINI_TERTIARY_MODEL. See app/rate_limits.py for the free-tier RPM/TPM/RPD
# each is checked against before the gateway attempts it — proactively
# skipping an exhausted model rather than waiting for a 429.
#
# NOTE: SPEC.md names gemini-2.5-flash/pro, but 2.5-flash now returns 404
# ("no longer available to new users") on new API keys and 2.5-pro is heavily
# rate-limited on the free tier. Keep gateway.py's _PRICING table in sync
# with whatever you set here, or cost_usd silently reports 0.0.
GEMINI_PRIMARY_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_TERTIARY_MODEL=gemini-3-flash-preview
# 0 disables Gemini's thinking phase: ~0.9s to first token instead of ~4.8s,
# and thinking tokens bill as output. Blank leaves the model default.
GEMINI_THINKING_BUDGET=0
# llama-3.3-70b-versatile was removed from Groq's free tier (no longer listed
# at console.groq.com/docs/rate-limits) — these are its current free-tier
# replacements, tried in order. $0 on the free tier either way.
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL_2=openai/gpt-oss-20b

# Per-call provider timeout, in seconds, before failing over to the fallback.
LLM_TIMEOUT_SECONDS=30

# --- Auth (optional: Google sign-in + per-user notebooks) ---
# OAuth 2.0 Web client ID from https://console.cloud.google.com/apis/credentials
# Must match the frontend's AUTH_GOOGLE_ID. Leave EMPTY to disable auth: the
# API then runs as the sentinel `local-dev` user and owns all existing data.
GOOGLE_CLIENT_ID=

# --- Web search (optional: source discovery, NOT a retrieval path) ---
# Lets you search the web and add results as notebook sources. Chosen results
# go through the same URL ingestion pipeline as a pasted link, so citations
# still resolve to real chunks. Leave empty to switch the feature off — the
# /search endpoint returns 503 and the UI hides the search box.
# Free tier: https://app.tavily.com/  (keys look like tvly-...)
TAVILY_API_KEY=
SEARCH_RESULT_COUNT=8
SEARCH_TIMEOUT_SECONDS=10

# --- Embeddings (hosted — Gemini, same GEMINI_API_KEY as chat) ---
# Was local (sentence-transformers/MiniLM) until torch's baseline memory
# footprint was confirmed in production to exceed Render's free-tier 512MB
# ceiling for a single typical source, no concurrency involved. Free tier:
# 100 RPM / 30,000 TPM / 1,000 RPD (aistudio.google.com/rate-limit). 768 is a
# Matryoshka-truncated dimension (native output is 3072); keep EMBEDDING_DIM
# in sync with the vector(768) column in the migrations.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# --- RAG parameters ---
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
RETRIEVAL_TOP_K=5

# Prior turns replayed into the prompt so follow-ups ("what about that?")
# resolve. Counts messages, so 6 ~ 3 exchanges. 0 disables conversation memory.
CHAT_HISTORY_TURNS=6

# --- Semantic cache ---
# Lets a paraphrase reuse a cached answer when retrieval returned the same
# chunks. Threshold is cosine similarity on the query embedding.
#
# OFF by default since switching embeddings from local MiniLM to
# gemini-embedding-001: the 0.97 threshold here was tuned for MiniLM's
# embedding space and does not transfer. A quick check against
# gemini-embedding-001 found the margin too thin to trust from a single
# sample pair — "what is retrieval augmented generation" (want HIT) scored
# 0.9804, while "How does retrieval-augmented generation WORK?" (a genuinely
# different question, want MISS) scored 0.9749, only 0.0055 apart. Needs a
# proper multi-pair measurement before re-enabling. Exact cache_key matching
# (identical prompt text) is unaffected by this setting.
SEMANTIC_CACHE_ENABLED=false
SEMANTIC_CACHE_THRESHOLD=0.97

# Caps how many sources parse/fetch/embed at once. Each added source runs in
# its own background task; without a cap, bulk-adding several at once
# multiplies peak memory and is the likely cause of an OOM crash on
# memory-constrained hosts (e.g. Render's free 512MB tier).
MAX_CONCURRENT_INGESTIONS=2
