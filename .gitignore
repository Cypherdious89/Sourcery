# Env files (never commit real secrets).
# Ignore every .env variant (.env, .env.local, .env.production, …) at any
# depth, then re-allow the committed templates.
.env
.env.*
**/.env
**/.env.*
!**/.env.example
!**/.env.sample

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node / Next.js
node_modules/
.next/
next-env.d.ts

# OS / editor
.DS_Store

# IDE
.idea/
.vscode/

# Build/verification artifacts
docs/shots/
*.log

# Exported conversation transcripts (/export)
*local-command-caveat*.txt

# Claude memory
Mem-Claude/
